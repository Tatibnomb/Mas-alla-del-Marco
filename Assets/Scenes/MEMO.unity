  m_Script: {fileID: 11500000, guid: 6b1deb8dde74c9e439f334f0764a4bd2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  descripcionDelCuadro: "Terraza en Sainte-Adresse \u2013 Claude Monet\n\nPintado
    en 1867 durante un verano familiar en Normand\xEDa, muestra un d\xEDa soleado
    en la costa, con banderas, sombrillas y barcos, simbolizando las vacaciones de
    la burgues\xEDa francesa. Es una escena luminosa, alegre y muy representativa
    del ambiente costero de la \xE9poca. Se relaciona con el D\xEDa del Padre porque
    incluye la figura del padre de Monet sentado con sombrero de panam\xE1."
